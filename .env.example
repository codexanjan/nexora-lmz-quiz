DATABASE_URL="postgresql://user:password@localhost:5432/nexora_learn?schema=public" # Or file:./dev.db for local SQLite
AUTH_SECRET="your-32-character-secret-key-here"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage Configuration (S3-compatible or local development)
STORAGE_MODE="local" # or "s3"
STORAGE_ENDPOINT=""
STORAGE_BUCKET="nexora-storage"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Background Job Queue
REDIS_URL="redis://localhost:6379"

# Transactional Email Provider
EMAIL_PROVIDER="development" # or "resend", "smtp"
EMAIL_API_KEY=""
EMAIL_FROM="Nexora Learn <notifications@nexora.io>"

# Observability
ERROR_MONITORING_DSN=""
